# =============================================================================
# What belongs in this repository
#
#   Tracked   : source, tests, protocol code, the measured JSON artifacts in
#               results/honest/, the manuscripts (.tex + final .pdf), and the
#               vector figures those manuscripts embed.
#   Untracked : datasets, model weights, embedding caches, build artifacts, and
#               anything a checked-in script can regenerate.
#
# Rule of thumb: if a command in the README reproduces it, it does not belong
# in git. The JSON artifacts are the exception -- they are the evidence behind
# every number in the papers, and they are small.
# =============================================================================

# --- environments ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- datasets (large, externally sourced, redistributable only by their owners)
KinFaceW-I/
KinFaceW-II/
TSKinFace_Data/
public/

# --- model weights and embedding caches --------------------------------------
# Regenerate with scripts/deploy/build_all_caches.py and build_arcface_cache.py,
# then the training scripts. Hundreds of MB; never useful in history.
weights/**/*.pt
weights/**/*.pth
weights/**/*.pkl
weights/**/*.npy
weights/**/*.onnx
weights/**/*.bak
outputs/**/*.pt
outputs/**/*.pkl

# --- generated figures -------------------------------------------------------
# The .pdf versions are tracked because the manuscripts embed them and LaTeX
# resolves \includegraphics{fig_x} to fig_x.pdf. The .png versions are
# preview-only duplicates regenerated by:
#   python scripts/evaluation/make_figures.py
#   FIGDIR=<ieee|elsevier> python scripts/evaluation/make_figures_extra.py
paper/*/figures/*.png

# --- LaTeX build artifacts ---------------------------------------------------
# Keep .tex and the final .pdf; everything else is produced by pdflatex.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.spl
*.synctex.gz
*.toc

# --- superseded material -----------------------------------------------------
# legacy/ keeps the old code and metadata for provenance (see legacy/README.md).
# Its plots and PDFs visualise results measured under the leaked protocol, so
# they are not worth carrying: the numbers they show are documented as wrong.
legacy/**/*.png
legacy/**/*.jpg
legacy/**/*.pdf
legacy/**/*.zip
legacy/**/*.pt
legacy/**/*.pkl

# --- results -----------------------------------------------------------------
# results/honest/*.json IS tracked -- it is the evidence base for the papers.
# Plots and bulky exports are not.
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.zip

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# --- scratch and logs --------------------------------------------------------
scratch/
tmp/
*.log
install*.log

# --- local media / generated attachments --------------------------------------
# A typoed folder name was being created as a personal asset dump; keep it out
# of the repository even if it is later renamed locally.
assests/
assets/
**/assests/
**/assets/

# --- OS and editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- local agent caches ------------------------------------------------------
.claude/
.superpowers/
